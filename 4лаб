class Receipt:
    
    def __init__(self, rid: int, date: str, amount: float, item: str):
        self.id = rid
        self.date = date
        self.sum = amount
        self.item = item
    
    def __setattr__(self, name, value):
        if name == 'id' and (not isinstance(value, int) or value <= 0):
            raise ValueError(f"ID положительное целое, а не {value}")
        if name == 'sum' and (not isinstance(value, (int, float)) or value < 0):
            raise ValueError(f"Сумма >= 0, а не {value}")
        if name in ('date', 'item') and (not value or not str(value).strip()):
            raise ValueError(f"Поле {name} не может быть пустым")
        super().__setattr__(name, value)
    
    def __repr__(self):
        return f"Чек({self.id}, '{self.date}', {self.sum:.2f}₽, '{self.item}')"
    
    def toDict(self):
        return {'id': self.id, 'date': self.date, 'sum': self.sum, 'item': self.item}


class ElectronicReceipt(Receipt):
    
    def __init__(self, rid: int, date: str, amount: float, item: str, email: str = ''):
        super().__init__(rid, date, amount, item)
        self.email = email
    
    def __setattr__(self, name, value):
        if name == 'email' and value and '@' not in str(value):
            raise ValueError("Некорректный email")
        super().__setattr__(name, value)
    
    def __repr__(self):
        return f"ЭлЧек({self.id}, '{self.date}', {self.sum:.2f}₽, '{self.item}', email='{self.email}')"
    
    def toDict(self):
        d = super().toDict()
        d['email'] = self.email
        return d
    
    @staticmethod
    def isValidEmail(email: str) -> bool:
        return '@' in email and '.' in email.split('@')[-1]


class ReceiptCollection:
    
    def __init__(self, filename=DATA_FILE):
        self.filename = filename
        self.items: List[Receipt] = []
        self._pos = 0
    
    def __getitem__(self, idx: int) -> Receipt:
        return self.items[idx]
    
    def __iter__(self) -> Iterator[Receipt]:
        self._pos = 0
        return self
    
    def __next__(self) -> Receipt:
        if self._pos >= len(self.items):
            raise StopIteration
        item = self.items[self._pos]
        self._pos += 1
        return item
    
    def __repr__(self):
        return f"Коллекция('{self.filename}', чеков: {len(self.items)})"
    
    def __len__(self):
        return len(self.items)
    
    def __contains__(self, rid: int) -> bool:
        return any(r.id == rid for r in self.items)
    
    def byMinSum(self, min_sum: float):
        for r in self.items:
            if r.sum >= min_sum:
                yield r
    
    def byItem(self, text: str):
        t = text.lower()
        for r in self.items:
            if t in r.item.lower():
                yield r
    
    def byType(self, cls):
        for r in self.items:
            if isinstance(r, cls):
                yield r
    
    @staticmethod
    def countFiles(path: str) -> int:
        try:
            return sum(1 for f in os.listdir(path) if os.path.isfile(os.path.join(path, f)))
        except FileNotFoundError:
            return 0
    
    @staticmethod
    def formatSum(amount: float) -> str:
        return f"{amount:,.2f} ₽"
    
    def add(self, r: Receipt):
        if r.id in self:
            raise ValueError(f"ID={r.id} уже есть")
        self.items.append(r)
    
    def load(self):
        self.items.clear()
        if not os.path.exists(self.filename):
            return
        with open(self.filename, 'r', encoding='utf-8') as f:
            for row in csv.DictReader(f):
                try:
                    if 'email' in row and row.get('email', '').strip():
                        self.items.append(ElectronicReceipt(
                            int(row['id']), row['date'], float(row['sum']), row['item'], row.get('email', '')
                        ))
                    else:
                        self.items.append(Receipt(int(row['id']), row['date'], float(row['sum']), row['item']))
                except (ValueError, KeyError):
                    pass
    
    def save(self):
        fields = ['id', 'date', 'sum', 'item', 'email']
        with open(self.filename, 'w', encoding='utf-8', newline='') as f:
            w = csv.DictWriter(f, fieldnames=fields, extrasaction='ignore')
            w.writeheader()
            for r in self.items:
                w.writerow(r.toDict())
    
    def sortBy(self, field):
        new_c = ReceiptCollection(self.filename)
        new_c.items = sorted(self.items, key=lambda r: getattr(r, field, ''))
        return new_c
    
    def show(self, title=""):
        if title:
            print(f"\n{title}")
        if not self.items:
            print("Пусто")
            return
        for r in self.items:
            print(f"  [{r.id}] {r.date} | {r.sum:.2f}₽ | {r.item}")


